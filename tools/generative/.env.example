# Copy to .env OUTSIDE this repo, or export these in your shell. Never commit a
# filled-in copy: .gitignore covers .env and .env.*, and the tools read the
# environment only. No script in tools/generative/ ever opens a key file.
#
#   set -a; . ~/.config/reel/generative.env; set +a
#
# ELEVENLABS_API_KEY   voice.py takes / sweep / clone. Get it from the
#                      ElevenLabs dashboard, Profile, API Keys.
# ELEVENLABS_CLONE_API_KEY
#                      optional. voice.py clone needs a key carrying the
#                      `create_instant_voice_clone` permission. A shared engine
#                      key generally does NOT have that scope and the failure
#                      is a 401 at /v1/voices/add, not at TTS. Set this only
#                      when the clone-scoped key differs from the TTS key.
# FAL_KEY              plate.py, every provider. fal.ai dashboard, Keys.
#
# music.py and drift.py need no key at all.

ELEVENLABS_API_KEY=
ELEVENLABS_CLONE_API_KEY=
FAL_KEY=
